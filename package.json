{
  "name": "kw-os",
  "version": "2.0.1",
  "description": "Knowledge Worker Operating System — turn any IDE into an AI-powered knowledge worker with local MCP servers, skills, and document intelligence. Zero API keys required.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "kw-os": "./bin/kw-os.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node bin/kw-os.js test",
    "test:env": "node bin/kw-os.js test --suite env",
    "test:registry": "node bin/kw-os.js test --suite registry",
    "test:skills": "node bin/kw-os.js test --suite skills",
    "test:build": "node bin/kw-os.js test --suite build",
    "test:install": "node bin/kw-os.js test --suite install",
    "test:health": "node bin/kw-os.js test --suite health",
    "lint": "eslint src/",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mcp",
    "knowledge-work",
    "ai-agent",
    "local-first",
    "cursor",
    "windsurf",
    "vscode",
    "claude-code",
    "powerpoint",
    "excel",
    "pdf",
    "browser-automation",
    "playwright",
    "financial-analysis"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "registry/",
    "templates/",
    "skills/",
    "prompts/",
    "config-profiles/",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.1",
    "semver": "^7.6.0",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@types/which": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
