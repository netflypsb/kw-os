        "@sylphx/pdf-reader-mcp"
      ]
    },
    "markitdown": {
      "command": "uvx",
      "args": [
        "markitdown"
      ]
    },
    "read-website-fast": {
      "command": "npx",
      "args": [
        "-y",
        "@just-every/mcp-read-website-fast"
      ]
    },
    "json": {
      "command": "npx",
      "args": [
        "-y",
        "json-mcp"
      ]
    },
    "imagician": {
      "command": "npx",
      "args": [
        "-y",
        "@flowy11/imagician"
      ]
    }
  }
